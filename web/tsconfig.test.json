{
  // Unit tests (vitest), e2e (Playwright) and the configs: Node types on top of the browser settings.
  "extends": "./tsconfig.json",
  "compilerOptions": { "types": ["vite/client", "@webgpu/types", "node"] },
  "include": ["src/*.ts", "src/*.tsx", "src/env.d.ts", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["src/web"]
}
